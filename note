                            'SELESAI'=>['Surat Terbit','ppill-selesai'],
                            'DITOLAK'=>['Ditolak','ppill-ditolak'],
                        ];
                        return isset($map[$status]) ? $map[$status] : [$status,'ppill-draft'];
                    }
