// ==================== TEMPLATE SURAT ====================

    public function edit_template() {
        $this->load->model('Surat_template_model');
        $data['template'] = $this->Surat_template_model->get();
        $this->load->view('admin/edit_template', $data);
    }

    public function update_template() {
        $this->load->model('Surat_template_model');
        $this->Surat_template_model->update_template([
            'header'               => $this->input->post('header'),
            'footer'               => $this->input->post('footer'),
            'kepala_dinas'         => $this->input->post('kepala_dinas'),
            'nip_kepala_dinas'     => $this->input->post('nip_kepala_dinas'),
            'nomor_surat_format'   => $this->input->post('nomor_surat_format'),
        ]);
        $this->log('EDIT_TEMPLATE', 'template', 1, 'Mengedit template surat');
        $this->session->set_flashdata('success', 'Template surat berhasil diupdate.');
        redirect('admin/edit_template');
    }

    // ==================== FOOTER WEBSITE ====================

    public function edit_footer() {
        $this->load->model('Site_settings_model');
        $data['settings'] = $this->Site_settings_model->get();
        $this->load->view('admin/edit_footer', $data);
    }

    public function update_footer() {
        $this->load->model('Site_settings_model');
        $this->Site_settings_model->update_footer($this->input->post('footer_text'));
        $this->log('EDIT_FOOTER', 'settings', 1, 'Mengedit footer website');
        $this->session->set_flashdata('success', 'Footer berhasil diupdate.');
        redirect('admin/edit_footer');
    }

