<script>
    function fillTemplate(templateId) {
        var titleField = document.querySelector('input[name="title"]');
        var msgField = document.querySelector('textarea[name="message"]');
        if (templateId === 1) {
            titleField.value = 'Surat Keterangan TKA Siap';
            msgField.value = 'Surat keterangan untuk TKA atas nama [Nama TKA] telah selesai. Silakan download di menu Data TKA.';
        } else if (templateId === 2) {
            titleField.value = 'Verifikasi TKA Berhasil';
            msgField.value = 'Pengajuan TKA Anda telah diverifikasi dan disetujui. Status dapat dilihat di dashboard.';
        } else if (templateId === 3) {
            titleField.value = 'Data TKA Perlu Dilengkapi';
            msgField.value = 'Data detail TKA Anda belum lengkap. Silakan lengkapi di menu Data TKA.';
        } else if (templateId === 4) {
            titleField.value = 'Pengumuman Penting';
            msgField.value = 'Ada pembaruan sistem. Mohon perhatikan informasi terbaru di website.';
        }
    }
</script>
