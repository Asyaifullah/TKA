                    function getProgressPill($status) {
                        $map = [
                            'DRAFT'=>['Belum Lengkap','ppill-draft'],
                            'MENUNGGU_KASI'=>['Verif. Kasi','ppill-kasi'],
                            'MENUNGGU_KABID'=>['Verif. Kabid','ppill-kabid'],
